{
  "name": "remark-pdf",
  "version": "0.3.0",
  "description": "remark plugin to compile markdown to pdf.",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./lib/index.d.ts",
      "require": "./lib/index.cjs",
      "default": "./lib/index.js"
    },
    "./plugins/*": {
      "types": "./lib/plugins/*/index.d.ts",
      "require": "./lib/plugins/*/index.cjs",
      "default": "./lib/plugins/*/index.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "vite build",
    "test": "vitest run --project unit",
    "test:cli": "vitest run --project cli",
    "tsc": "tsc -p . --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "typedoc": "typedoc",
    "format": "prettier '**/*.{js,ts,jsx,tsx}' --write --cache",
    "format:ci": "prettier '**/*.{js,ts,jsx,tsx}' -l",
    "prepublishOnly": "npm run typedoc && npm run build"
  },
  "dependencies": {
    "@mathjax/mathjax-newcm-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "bidi-js": "^1.1.0",
    "github-slugger": "^2.0.0",
    "image-size": "^2.1.0",
    "linebreak": "^2.0.0",
    "mdast-util-definitions": "^6.0.0",
    "mdast-util-to-hast": "^13.2.2",
    "mdast-util-to-string": "^4.0.0",
    "pdfkit": "^0.21.0",
    "svg-to-pdfkit": "^0.1.8",
    "unist-util-visit": "^5.2.0"
  },
  "devDependencies": {
    "@native-html/transient-render-engine": "^12.0.2",
    "@storybook/react-vite": "10.6.7",
    "@types/file-saver": "^2.0.7",
    "@types/hast": "^3.0.5",
    "@types/jest-image-snapshot": "^6.4.2",
    "@types/lodash.debounce": "^4.0.9",
    "@types/mdast": "^4.0.3",
    "@types/node": "^26.6.6",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "jest-image-snapshot": "^6.5.2",
    "lodash.debounce": "^4.0.8",
    "pdf-to-img": "^7.0.2",
    "pdfjs-dist": "~6.5.438",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-simple-code-editor": "^0.14.1",
    "remark-cli": "^12.0.1",
    "remark-embed-images": "^5.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "storybook": "10.6.7",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.4",
    "vite": "^8.3.8",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inokawa/remark-pdf.git"
  },
  "keywords": [
    "unist",
    "remark",
    "mdast",
    "markdown",
    "pdf",
    "pandoc",
    "latex",
    "math"
  ],
  "author": "inokawa <stratoooo-taster@yahoo.co.jp> (https://github.com/inokawa/)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/inokawa/remark-pdf/issues"
  },
  "homepage": "https://github.com/inokawa/remark-pdf#readme",
  "overrides": {
    "pdf-to-img": {
      "pdfjs-dist": "$pdfjs-dist"
    },
    "react-native": "npm:empty-npm-package@1.0.0"
  }
}
